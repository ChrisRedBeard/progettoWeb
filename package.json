{
  "name": "fit-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/postgres.ts up && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "tsx scripts/postgres.ts up",
    "db:down": "tsx scripts/postgres.ts down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "tsx scripts/postgres.ts up && prisma migrate dev && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "6.19.3",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.173.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.173.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "happy-dom": "^20.0.10",
    "tsx": "^4.20.3",
    "vitest": "^4.0.8",
    "typescript": "^5.8.2"
  }
}
