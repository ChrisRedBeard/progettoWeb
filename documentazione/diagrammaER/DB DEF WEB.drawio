        <mxCell id="OkaHNvmNrRIdM4LqRzYP-832" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;V1:UN UTENTE PUò ESSERE O COACH O ATLETA;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;V2:L&#39;ATLETA UTILIZZA IL MONITORAGGIO AI SOLO CON ABBONAMENTO AI ATTIVO;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;V3: LE STATISTICHE VENGONO RICAVATE DA MONITORAGGIO AI E DIRETTA;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;V4: LA DIRETTA è ABILITATA SOLO SE L&#39;ATLETA NON HA IMPOSTATO LO STATO COME PRIVATO;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;V5: UN ATLETA PUò NON AVVIARE LA DIRETTA MA ESSERE COMUNQUE MONITORATO DALL&#39;AI SE POSSIEDE UN ABBONAMENTO AI.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;V6: IL CATALOGO è UNICO PER L&#39;ATLETA, MENTRE IL COACH VEDE SIA QUELLO PERSONALE CHE QUELLO PUBBLICO;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;V7: I SERVIZI ESTERNI PER PAGAMENTI,EMAIL,AUTENTICAZIONE E PERSISTENZA VIDEO NON SONO CITATI NEL DATABASE;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;V8:SE L&#39;UTENTE HA STATO CANCELLATO ALLORA NON PUò PIU ESEGUIRE AZIONI SUL SISTEMA SE NON REGISTRARSI NUOVAMENTE;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;V9: IL COACH HA UNA LOBBY CHE PUò DIVIDERE IN PIU CATEGORIE PER SMISTARE I CLIENTI;&lt;br&gt;V10: IL COACH PUò PARTECIPARE AD UNA DIRETTA PER VOLTA.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;V11: L&#39;ATTRIBUTO &quot;ANALISI X AI&quot; IN ESERCIZIO SERVE PER SPECIFICARE ALL&#39;AI COSA TENERE D&#39;OCCHIO DURANTE L&#39;ESECUZIONE PER FACILITARE L&#39;ADDESTRAMENTO DELL&#39;AI.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="585" width="1602" x="3876" y="-935" as="geometry" />
        </mxCell>
