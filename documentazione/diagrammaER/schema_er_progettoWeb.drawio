as="geometry"/></mxCell><mxCell id="g2_lobby" style="endArrow=none;html=1;rounded=0;strokeWidth=1.5;jumpStyle=arc;jumpSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="ent_lobby" target="g2_j"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="555"/></Array></mxGeometry></mxCell><mxCell id="g2_chat" style="endArrow=none;html=1;rounded=0;strokeWidth=1.5;jumpStyle=arc;jumpSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="ent_chat" target="g2_j"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1950" y="555"/></Array></mxGeometry></mxCell><mxCell id="g2_arrow" style="endArrow=block;endFill=1;endSize=12;html=1;rounded=0;strokeWidth=1.5;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2_j" target="ent_conv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g2_lbl" value="(t,e)" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1712.0" y="508.0" width="50" height="24" as="geometry"/></mxCell><mxCell id="note_title" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;Schema E-R – progettoWebChristian&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2300.0" y="1420.0" width="1000" height="40" as="geometry"/></mxCell><mxCell id="note_legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;● identificatore &amp;nbsp; ○ attributo &amp;nbsp; (0,1) attributo opzionale&lt;br&gt;(min,max) sul ramo = quante volte un&#x27;istanza dell&#x27;entità partecipa all&#x27;associazione&lt;br&gt;min 0 = partecipazione parziale (un sottoinsieme) &amp;nbsp;·&amp;nbsp; min 1 = totale (tutte)&lt;br&gt;(t,s) generalizzazione totale e sovrapposta &amp;nbsp;·&amp;nbsp; (t,e) totale ed esclusiva" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="2300.0" y="1470.0" width="1000" height="120" as="geometry"/></mxCell><mxCell id="note_vincoli" value="&lt;b&gt;Vincoli di integrità non esprimibili nello schema&lt;/b&gt;&lt;br&gt;V1 · Una Chat privata esiste solo per un Invito con stato = &#x27;accettato&#x27;.&lt;br&gt;V2 · Mittente e destinatario di un Invito devono essere utenti diversi.&lt;br&gt;V3 · Un Messaggio può taggare solo una Sessione dell&#x27;atleta della chat in cui è inviato (non nelle lobby).&lt;br&gt;V4 · Il mittente di un Messaggio / partecipante a una Videochiamata deve far parte della conversazione.&lt;br&gt;V5 · Un Coach assegna Schede solo ad atleti con cui ha una Chat privata attiva.&lt;br&gt;V6 · Pagamento: tra atleta e coach deve esistere un Invito accettato.&lt;br&gt;V7 · Una Scheda con origine = &#x27;generata_AI&#x27; richiede un Abbonamento AI attivo alla data di creazione.&lt;br&gt;V8 · Se una Sessione è Basata su una Scheda, la Scheda appartiene allo stesso atleta.&lt;br&gt;V9 · Numero di membri di una Lobby ≤ max_partecipanti." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2300.0" y="1610.0" width="1000" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>